global:
    external_labels:
        monitor: test-monitor
    scrape_interval: 5s

scrape_configs:
    - job_name: prometheus
      static_configs:
          - targets:
                - "localhost:9090"
    - job_name: node-exporter
      static_configs:
          - targets:
                - "node-exporter:9100"
    - job_name: "decm-backend"
      scrape_interval: 5s
      metrics_path: /metrics
      scheme: http
      authorization:
          credentials: "${METRICS_API_KEY}"
      static_configs:
          - targets:
                - "decm-backend-prod:8080"
