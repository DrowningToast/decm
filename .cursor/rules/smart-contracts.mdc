## Frontend Integration

### Setup wagmi
```typescript
import { createConfig, http } from 'wagmi';
import { sepolia, localhost } from 'wagmi/chains';

export const config = createConfig({
  chains: [localhost, sepolia],
  transports: {
    [localhost.id]: http(),
    [sepolia.id]: http(process.env.VITE_SEPOLIA_RPC_URL),
  },
});
```

### Contract Interaction Hooks

#### Read Contract Data:
```typescript
import { useContractRead } from 'wagmi';
import { EventTicket } from '@/abi/EventTicket';

export const useTicketData = (ticketId: bigint) => {
  const { data, isLoading, error } = useContractRead({
    address: CONTRACT_ADDRESS,
    abi: EventTicket,
    functionName: 'getTicketMetadata',
    args: [ticketId],
  });

  return { ticketData: data, isLoading, error };
};
```

#### Write to Contract:
```typescript
import { useContractWrite, useWaitForTransaction } from 'wagmi';
import { EventTicket } from '@/abi/EventTicket';

export const useMintTicket = () => {
  const { write, data } = useContractWrite({
    address: CONTRACT_ADDRESS,
    abi: EventTicket,
    functionName: 'mintTicket',
  });

  const { isLoading, isSuccess } = useWaitForTransaction({
    hash: data?.hash,
  });

  const mintTicket = async (eventId: bigint, recipient: string, metadata: string) => {
    await write({
      args: [eventId, recipient, metadata],
    });
  };

  return { mintTicket, isLoading, isSuccess };
};
```

#### Listen to Events:
```typescript
import { useContractEvent } from 'wagmi';
import { EventTicket } from '@/abi/EventTicket';

export const useTicketMinted = (onTicketMinted: (data: any) => void) => {
  useContractEvent({
    address: CONTRACT_ADDRESS,
    abi: EventTicket,
    eventName: 'TicketMinted',
    listener: (logs) => {
      const log = logs[0];
      onTicketMinted({
        eventId: log.args.eventId,
        recipient: log.args.recipient,
        ticketId: log.args.ticketId,
      });
    },
  });
};
```

### ABI Generation

ABIs are auto-generated during contract compilation:

```bash
# Compile contracts (generates ABIs)
forge build

# ABIs output to: out/ContractName.sol/ContractName.json
```

**Copy ABIs to frontend**:
```bash
# Copy EventTicket ABI
cp apps/contracts/out/EventTicket.sol/EventTicket.json apps/web/src/abi/

# Copy EventCertificate ABI
cp apps/contracts/out/EventCertificate.sol/EventCertificate.json apps/web/src/abi/
```

### TypeScript ABI Types

Generate TypeScript types from ABIs:

```typescript
// apps/web/src/abi/EventTicket.ts
import EventTicketABI from './EventTicket.json';

export const EventTicket = EventTicketABI.abi as const;
export type EventTicketABI = typeof EventTicket;
```

## Contract Interaction Flow

### Minting Event Ticket:
1. **Backend**: Verify user registration
2. **Backend**: Generate ticket metadata
3. **Backend**: Sign transaction or approve minting
4. **Frontend**: Connect wallet
5. **Frontend**: Call `mintTicket` with user's wallet
6. **Contract**: Mint NFT ticket to user
7. **Frontend**: Wait for confirmation
8. **Backend**: Store ticket ID and transaction hash

### Issuing Certificate:
1. **Backend**: Verify event completion
2. **Backend**: Verify participant attendance
3. **Backend**: Generate certificate metadata and URI
4. **Frontend**: Request certificate issuance
5. **Contract**: Mint NFT certificate
6. **Backend**: Store certificate ID
7. **Frontend**: Display certificate with QR code

## Best Practices

### ✅ DO:
- Use OpenZeppelin contracts for standards (ERC-721, AccessControl)
- Write comprehensive tests for all functions
- Use custom errors instead of require strings (gas efficient)
- Emit events for all state changes
- Use natspec comments for documentation
- Validate all inputs
- Use modifiers for access control
- Version contracts properly
- Test on testnet before mainnet

### ❌ DON'T:
- Deploy without thorough testing
- Use floating pragma versions
- Skip input validation
- Ignore gas optimization
- Hard-code addresses in contracts
- Allow unauthorized access
- Skip event emission
- Use tx.origin for authentication
- Store large data on-chain

## Gas Optimization

```solidity
// ✅ Good: Use custom errors
error Unauthorized();
if (!hasAccess) revert Unauthorized();

// ❌ Bad: Use require strings
require(hasAccess, "User is not authorized");

// ✅ Good: Pack storage variables
struct Ticket {
    uint128 eventId;  // 16 bytes
    uint128 ticketId; // 16 bytes (same slot)
    address owner;     // 20 bytes (new slot)
}

// ✅ Good: Use immutable for constants
address public immutable accessManager;

// ✅ Good: Cache array length
uint256 length = tickets.length;
for (uint256 i = 0; i < length; i++) {
    // ...
}
```

## Security Considerations

### Access Control:
```solidity
modifier onlyOrganizer(uint256 eventId) {
    if (!accessManager.isEventOrganizer(eventId, msg.sender)) {
        revert Unauthorized();
    }
    _;
}

function cancelEvent(uint256 eventId) external onlyOrganizer(eventId) {
    // Only organizer can cancel
}
```

### Reentrancy Protection:
```solidity
import "@openzeppelin/contracts/security/ReentrancyGuard.sol";

contract EventTicket is ReentrancyGuard {
    function mintTicket(...) external nonReentrant {
        // Safe from reentrancy
    }
}
```

### Integer Overflow:
```solidity
// Solidity 0.8+ has built-in overflow checks
// No need for SafeMath
```

