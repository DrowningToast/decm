### Container Styling
```tsx
<div className={cn(
    className,  // From context
    "flex items-center gap-1.5",  // Layout
    "h-13 bg-primary rounded-xl p-1.5"  // Design tokens
)}>
```

### Responsive Design
```tsx
<div className={cn(
    "flex flex-col md:flex-row",
    "w-full md:w-[343px]",
    "p-2 md:p-4"
)}>
```

### Fixed vs Full Width
```tsx
const widthClass = isFixed ? "w-[343px]" : "w-full";
```

## Best Practices

### ✅ DO:
- Use Zustand for feature-specific state management
- Access context with `useBottomContainerContext()`
- Combine `className` from context with component-specific styles using `cn()`
- Use `useMemo()` for variant switching in BottomNav
- Always use i18n for text content
- Keep variant components focused and single-purpose
- Export stores from `stores.ts` with descriptive names
- Use TypeScript interfaces for store state

### ❌ DON'T:
- Mix state management patterns (don't use useState for shared state)
- Ignore the `className` from context
- Hard-code text strings (use i18n)
- Create deeply nested component hierarchies
- Put business logic in variant components (use hooks/usecases)
- Forget to add new variants to the type union
- Use default exports (always use named exports)
- Access stores directly outside of React components

## Common Patterns

### Search Input Pattern
```tsx
<input
    type="text"
    value={searchQuery}
    onChange={(e) => setSearchQuery(e.target.value)}
    placeholder={t("feature.searchPlaceholder")}
    className="flex-1 h-10 px-4 rounded-lg bg-white text-sm"
/>
```

### Back Button Pattern
```tsx
<button
    onClick={onBack}
    className="flex items-center justify-center w-10 h-10 bg-primary rounded-lg"
    aria-label="Go back"
>
    <ChevronLeft className="w-5 h-5 text-white" />
</button>
```

### Action Button Pattern
```tsx
<button
    onClick={handleAction}
    className="flex items-center gap-2 px-4 h-10 bg-secondary rounded-lg"
>
    <ActionIcon className="w-5 h-5" />
    <span>{t("feature.action")}</span>
</button>
```

## Integration with Usecases

Bottom navbar state should integrate with page usecases:

```tsx
// In usecase hook
import { useSearchCertificateNavStore } from "@/components/BottomContainer/stores";

export const useCertificatesListUsecase = () => {
    const { searchQuery } = useSearchCertificateNavStore();
    
    const filteredCertificates = certificates.filter((cert) =>
        cert.name.toLowerCase().includes(searchQuery.toLowerCase())
    );
    
    return filteredCertificates;
};
```

## Testing Considerations

### Unit Testing Zustand Stores
```tsx
import { renderHook, act } from '@testing-library/react';
import { useSearchCertificateNavStore } from './stores';

test('should update search query', () => {
    const { result } = renderHook(() => useSearchCertificateNavStore());
    
    act(() => {
        result.current.setSearchQuery('test');
    });
    
    expect(result.current.searchQuery).toBe('test');
});
```

### Component Testing
```tsx
import { render, screen } from '@testing-library/react';
import { BottomNav } from './BottomNav';

test('renders correct variant', () => {
    render(<BottomNav variant="search-certificate" />);
    expect(screen.getByPlaceholderText(/search/i)).toBeInTheDocument();
});
```

