# Form Handling Patterns

**Tech**: React Hook Form + Zod + Radix UI

Setup:
```bash
pnpm add react-hook-form @hookform/resolvers zod
```

## Basic Form Pattern

### 1. Define Schema (Zod)

```typescript
import { z } from 'zod';

export const signUpSchema = z.object({
  email: z
    .string()
    .min(1, 'Email is required')
    .email('Invalid email address'),
  firstName: z
    .string()
    .min(1, 'First name is required')
    .max(50, 'First name too long'),
  lastName: z
    .string()
    .min(1, 'Last name is required')
    .max(50, 'Last name too long'),
  password: z
    .string()
    .min(8, 'Password must be at least 8 characters')
    .regex(/[A-Z]/, 'Password must contain uppercase letter')
    .regex(/[a-z]/, 'Password must contain lowercase letter')
    .regex(/[0-9]/, 'Password must contain number')
    .regex(/[^A-Za-z0-9]/, 'Password must contain special character'),
  confirmPassword: z.string(),
  role: z.enum(['student', 'faculty', 'staff'], {
    errorMap: () => ({ message: 'Please select a role' }),
  }),
}).refine((data) => data.password === data.confirmPassword, {
  message: "Passwords don't match",
  path: ['confirmPassword'],
});

export type SignUpFormData = z.infer<typeof signUpSchema>;
```

### 2. Create Form Component

```typescript
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { signUpSchema, SignUpFormData } from './schema';
import { Typography } from '@/components/typography/typography';
import { useTranslation } from 'react-i18next';

export const SignUpForm = () => {
  const { t } = useTranslation();
  const {
    register,
    handleSubmit,
    formState: { errors, isSubmitting },
    setError,
  } = useForm<SignUpFormData>({
    resolver: zodResolver(signUpSchema),
    defaultValues: {
      email: '',
      firstName: '',
      lastName: '',
      password: '',
      confirmPassword: '',
      role: undefined,
    },
  });

  const onSubmit = async (data: SignUpFormData) => {
    try {
      const api = new DefaultApi({
        basePath: config.apiUrl,
        withCredentials: true,
      });

      const response = await api.registerUser({
        email: data.email,
        first_name: data.firstName,
        last_name: data.lastName,
        password: data.password,
        role: data.role,
      });

      // Success - redirect or show success message
      toast.success(t('signup.success'));
      navigate('/dashboard');
    } catch (error) {
      if (error instanceof AxiosError && error.response) {
        const errData = error.response.data;
        
        // Handle validation errors from backend
        if (errData.status === 400 && errData.details) {
          setError('email', {
            message: errData.details.email || errData.message,
          });
        } else if (errData.status === 409) {
          setError('email', {
            message: t('signup.errors.emailExists'),
          });
        } else {
          toast.error(t('errors.generic'));
        }
      }
    }
  };

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
      {/* Email Field */}
      <div>
        <Typography variant="text" tag="label" htmlFor="email" className="text-sm font-medium">
          {t('auth.email')}
        </Typography>
        <input
          id="email"
          type="email"
          {...register('email')}
          className="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2"
          aria-invalid={errors.email ? 'true' : 'false'}
          aria-describedby={errors.email ? 'email-error' : undefined}
        />
        {errors.email && (
          <Typography
            variant="text"
            tag="p"
            id="email-error"
            className="mt-1 text-sm text-destructive"
          >
            {errors.email.message}
          </Typography>
        )}
      </div>

      {/* First Name Field */}
      <div>
        <Typography variant="text" tag="label" htmlFor="firstName" className="text-sm font-medium">
          {t('auth.firstName')}
        </Typography>
        <input
          id="firstName"
          type="text"
          {...register('firstName')}
          className="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2"
        />
        {errors.firstName && (
          <Typography variant="text" tag="p" className="mt-1 text-sm text-destructive">
            {errors.firstName.message}
          </Typography>
        )}
      </div>

      {/* Password Field */}
      <div>
        <Typography variant="text" tag="label" htmlFor="password" className="text-sm font-medium">
          {t('auth.password')}
        </Typography>
        <input
          id="password"
          type="password"
          {...register('password')}
          className="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2"
        />
        {errors.password && (
          <Typography variant="text" tag="p" className="mt-1 text-sm text-destructive">
            {errors.password.message}
          </Typography>
        )}
      </div>

      {/* Role Select */}
      <div>
        <Typography variant="text" tag="label" htmlFor="role" className="text-sm font-medium">
          {t('auth.role')}
        </Typography>
        <select
          id="role"
          {...register('role')}
          className="mt-1 block w-full rounded-md border border-input bg-background px-3 py-2"
        >
          <option value="">{t('auth.selectRole')}</option>
          <option value="student">{t('roles.student')}</option>
          <option value="faculty">{t('roles.faculty')}</option>
          <option value="staff">{t('roles.staff')}</option>
        </select>
        {errors.role && (
          <Typography variant="text" tag="p" className="mt-1 text-sm text-destructive">
            {errors.role.message}
          </Typography>
        )}
      </div>

      {/* Submit Button */}
      <button
        type="submit"
        disabled={isSubmitting}
        className="w-full rounded-md bg-primary px-4 py-2 text-primary-foreground hover:bg-primary/90 disabled:opacity-50"
      >
        {isSubmitting ? t('common.loading') : t('auth.signUp')}
      </button>
    </form>
  );
};
```

## Form Components with Radix UI

### Reusable Form Field Component

```typescript
import { useFormContext } from 'react-hook-form';
import { Typography } from '@/components/typography/typography';

interface FormFieldProps {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'password' | 'number';
  placeholder?: string;
  required?: boolean;
}

export const FormField = ({
  name,
  label,
  type = 'text',
  placeholder,
  required,
}: FormFieldProps) => {
  const {
    register,
    formState: { errors },
  } = useFormContext();

  const error = errors[name];

  return (
    <div className="space-y-2">
      <Typography variant="text" tag="label" htmlFor={name} className="text-sm font-medium">
        {label}
        {required && <span className="text-destructive ml-1">*</span>}
      </Typography>
      <input
        id={name}
        type={type}
        placeholder={placeholder}
        {...register(name)}
        className="block w-full rounded-md border border-input bg-background px-3 py-2 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
        aria-invalid={error ? 'true' : 'false'}
        aria-describedby={error ? `${name}-error` : undefined}
      />
      {error && (
        <Typography
          variant="text"
          tag="p"
          id={`${name}-error`}
          className="text-sm text-destructive"
        >
          {error.message?.toString()}
        </Typography>
      )}
    </div>
  );
};
```

### Usage with FormProvider

```typescript
import { FormProvider, useForm } from 'react-hook-form';
import { FormField } from '@/components/form/FormField';

export const MyForm = () => {
  const methods = useForm<FormData>({
    resolver: zodResolver(schema),
  });

  return (
    <FormProvider {...methods}>
      <form onSubmit={methods.handleSubmit(onSubmit)}>
        <FormField name="email" label="Email" type="email" required />
        <FormField name="firstName" label="First Name" required />
        <FormField name="lastName" label="Last Name" required />
        <button type="submit">Submit</button>
      </form>
    </FormProvider>
  );
};
```

## Advanced Validation Patterns

### Async Validation (Check Email Availability)

```typescript
const signUpSchema = z.object({
  email: z
    .string()
    .email('Invalid email')
    .refine(
      async (email) => {
        // Call API to check if email is available
        try {
          const api = new DefaultApi({ basePath: config.apiUrl });
          await api.checkEmailAvailability({ email });
          return true;
        } catch {
          return false;
        }
      },
      { message: 'Email already registered' }
    ),
});
```

### Conditional Validation

```typescript
const eventSchema = z.object({
  eventType: z.enum(['internal', 'external']),
  requiresAcademicVerification: z.boolean(),
  academicInstitution: z.string().optional(),
}).refine(
  (data) => {
    // Require academic institution if verification is needed
    if (data.requiresAcademicVerification && !data.academicInstitution) {
      return false;
    }
    return true;
  },
  {
    message: 'Academic institution is required',
    path: ['academicInstitution'],
  }
);
```

### Dynamic Field Validation

```typescript
const { watch, register } = useForm();
const eventType = watch('eventType');

return (
  <>
    <select {...register('eventType')}>
      <option value="internal">Internal</option>
      <option value="external">External</option>
    </select>

    {eventType === 'internal' && (
      <input
        {...register('academicInstitution', {
          required: 'Academic institution is required for internal events',
        })}
      />
    )}
  </>
);
```

## Backend Validation (Go)

### Struct Tags Validation

```go
type RegisterRequest struct {
    Email     string `json:"email" validate:"required,email"`
    FirstName string `json:"first_name" validate:"required,min=1,max=50"`
    LastName  string `json:"last_name" validate:"required,min=1,max=50"`
    Password  string `json:"password" validate:"required,min=8,containsany=ABCDEFGHIJKLMNOPQRSTUVWXYZ,containsany=0123456789"`
    Role      string `json:"role" validate:"required,oneof=student faculty staff"`
}

func (h *Handler) HandleRegister(ctx *fiber.Ctx) error {
    req := RegisterRequest{}
    if err := ctx.BodyParser(&req); err != nil {
        return customerror.New(
            customerror.StatusBadRequest,
            "Invalid request format",
            err,
        )
    }

    // Validate with go-validator
    if err := validatorutils.Validate(&req); err != nil {
        return customerror.NewValidationErr(err)
    }

    // Continue with registration
}
```

### Custom Validators

```go
import "github.com/go-playground/validator/v10"

func RegisterCustomValidators(v *validator.Validate) {
    // Ethereum address validator
    v.RegisterValidation("eth_addr", func(fl validator.FieldLevel) bool {
        address := fl.Field().String()
        return regexp.MustCompile(`^0x[0-9a-fA-F]{40}$`).MatchString(address)
    })

    // Strong password validator
    v.RegisterValidation("strong_password", func(fl validator.FieldLevel) bool {
        password := fl.Field().String()
        hasUpper := regexp.MustCompile(`[A-Z]`).MatchString(password)
        hasLower := regexp.MustCompile(`[a-z]`).MatchString(password)
        hasNumber := regexp.MustCompile(`[0-9]`).MatchString(password)
        hasSpecial := regexp.MustCompile(`[^A-Za-z0-9]`).MatchString(password)
        return len(password) >= 8 && hasUpper && hasLower && hasNumber && hasSpecial
    })
}

// Usage
type AuthRequest struct {
    WalletAddress string `json:"wallet_address" validate:"required,eth_addr"`
    Password      string `json:"password" validate:"required,strong_password"`
}
```

## Error Handling

### Frontend Error Mapping

```typescript
const handleBackendError = (error: AxiosError, setError: UseFormSetError) => {
  if (!error.response) {
    toast.error(t('errors.network'));
    return;
  }

  const errData = error.response.data as ErrorResponse;

  switch (errData.status) {
    case 400:
      // Validation errors
      if (errData.details) {
        Object.entries(errData.details).forEach(([field, message]) => {
          setError(field as any, { message: message as string });
        });
      } else {
        toast.error(errData.message);
      }
      break;

    case 409:
      // Conflict (e.g., email already exists)
      setError('email', { message: t('signup.errors.emailExists') });
      break;

    case 500:
      toast.error(t('errors.serverError'));
      break;

    default:
      toast.error(errData.message || t('errors.generic'));
  }
};
```

### Field-Level Error Display

```typescript
const { setError, clearErrors } = useForm();

// Set specific field error
setError('email', {
  type: 'manual',
  message: 'Email already registered',
});

// Clear specific field error
clearErrors('email');

// Clear all errors
clearErrors();
```

## Complex Form Patterns

### Multi-Step Form

```typescript
const [step, setStep] = useState(1);

const methods = useForm<MultiStepFormData>({
  resolver: zodResolver(multiStepSchema),
  mode: 'onChange',
});

const onSubmit = async (data: MultiStepFormData) => {
  if (step < 3) {
    setStep(step + 1);
  } else {
    // Submit final form
    await submitForm(data);
  }
};

return (
  <FormProvider {...methods}>
    <form onSubmit={methods.handleSubmit(onSubmit)}>
      {step === 1 && <StepOne />}
      {step === 2 && <StepTwo />}
      {step === 3 && <StepThree />}

      <div className="flex justify-between">
        {step > 1 && (
          <button type="button" onClick={() => setStep(step - 1)}>
            Previous
          </button>
        )}
        <button type="submit">
          {step === 3 ? 'Submit' : 'Next'}
        </button>
      </div>
    </form>
  </FormProvider>
);
```

### Array Fields (Dynamic Fields)

```typescript
import { useFieldArray } from 'react-hook-form';

const { fields, append, remove } = useFieldArray({
  control,
  name: 'participants',
});

return (
  <div>
    {fields.map((field, index) => (
      <div key={field.id}>
        <input {...register(`participants.${index}.name`)} />
        <input {...register(`participants.${index}.email`)} />
        <button type="button" onClick={() => remove(index)}>
          Remove
        </button>
      </div>
    ))}
    <button
      type="button"
      onClick={() => append({ name: '', email: '' })}
    >
      Add Participant
    </button>
  </div>
);
```

### File Upload

```typescript
const schema = z.object({
  avatar: z
    .instanceof(FileList)
    .refine((files) => files.length === 1, 'Avatar is required')
    .refine(
      (files) => files[0]?.size <= 5_000_000,
      'File size must be less than 5MB'
    )
    .refine(
      (files) => ['image/jpeg', 'image/png'].includes(files[0]?.type),
      'Only JPEG and PNG images are allowed'
    ),
});

// In component
<input
  type="file"
  accept="image/jpeg,image/png"
  {...register('avatar')}
  onChange={(e) => {
    // Preview image
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => {
        setPreview(reader.result as string);
      };
      reader.readAsDataURL(file);
    }
  }}
/>
```

## Best Practices

✅ DO:
- Use Zod for validation
- Validate on BOTH frontend and backend
- i18n for all messages
- Disable submit while submitting
- Handle backend validation errors

❌ DON'T:
- Trust client-side validation only
- Show technical errors
- Hard-code messages
- Skip accessibility attributes

## Accessibility

```typescript
// Proper label association
<label htmlFor="email">Email</label>
<input
  id="email"
  type="email"
  aria-invalid={errors.email ? 'true' : 'false'}
  aria-describedby={errors.email ? 'email-error' : undefined}
  aria-required="true"
/>
{errors.email && (
  <p id="email-error" role="alert">
    {errors.email.message}
  </p>
)}

// Form-level errors
<div role="alert" aria-live="polite">
  {formError && <p>{formError}</p>}
</div>
```

