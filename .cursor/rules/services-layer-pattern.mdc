## Integration with Other Patterns

### With Hooks
```tsx
// Hook wraps service for React Query integration
export const useCreateAccount = () => {
    return useMutation({
        mutationFn: (params: CreateAccountParams) => 
            authService.createAccount(params)
    });
};
```

### With Usecases
```tsx
// Usecase orchestrates multiple services
export const useOnboardingUsecase = () => {
    const checkStatus = async () => {
        const status = await onboardService.checkOnboardStatus();
        if (status?.authentication_credential_id) {
            // Already registered, redirect
        }
    };

    const createAccount = async (params: CreateAccountParams) => {
        await authService.createAccount(params);
        // Additional usecase logic
    };

    return { checkStatus, createAccount };
};
```

### With Context
```tsx
// Service can be accessed via context if needed
const AuthContext = createContext<{ authService: AuthService }>(null!);

export const useAuth = () => {
    const context = useContext(AuthContext);
    return context.authService;
};
```

## Common Service Patterns

### Batch Operations
```tsx
public async batchCreate(items: CreateParams[]): Promise<Response[]> {
    const promises = items.map(item => this._coreApi.v1.create(item));
    const results = await Promise.all(promises);
    
    await this._queryClient.invalidateQueries({ 
        queryKey: QUERY_KEY.domain.all 
    });
    
    return results;
}
```

### Conditional Logic
```tsx
public async createOrUpdate(params: CreateOrUpdateParams) {
    const existing = await this.findById(params.id);
    
    if (existing) {
        return this.update(params.id, params);
    } else {
        return this.create(params);
    }
}
```

### Transform Data
```tsx
public async getTransformed(id: string): Promise<TransformedData> {
    const raw = await this._coreApi.v1.get({ id });
    
    // Transform for frontend consumption
    return {
        id: raw.id,
        displayName: `${raw.first_name} ${raw.last_name}`,
        createdDate: new Date(raw.created_at)
    };
}
```

