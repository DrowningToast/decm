## Database Schema

### authentication_credentials

```sql
CREATE TABLE authentication_credentials (
    id UUID PRIMARY KEY,
    wallet_address TEXT UNIQUE, -- For wallet auth
    google_oauth_email BYTEA,   -- Encrypted, for OAuth
    password_hash TEXT,          -- For OAuth
    solution_status TEXT,        -- "byok" (Bring Your Own Keys)
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);
```

### profiles

```sql
CREATE TABLE profiles (
    id UUID PRIMARY KEY,
    authentication_credential_id UUID REFERENCES authentication_credentials(id),
    encrypted_email BYTEA,       -- PII encrypted
    encrypted_first_name BYTEA,  -- PII encrypted
    encrypted_last_name BYTEA,   -- PII encrypted
    encrypted_phone_number BYTEA,-- PII encrypted
    encrypted_address BYTEA,     -- PII encrypted
    bio TEXT,
    profile_picture_url TEXT,
    -- Privacy flags
    is_email_public BOOLEAN DEFAULT false,
    is_first_name_public BOOLEAN DEFAULT true,
    is_last_name_public BOOLEAN DEFAULT true,
    -- ... more fields
    created_at TIMESTAMP,
    updated_at TIMESTAMP
);
```

