## Sign Out Flow

### Frontend: useSignout Hook

[useSignout.ts](mdc:apps/web/src/components/useSignout.ts)

```typescript
export const useSignout = () => {
	const [, setAccessToken] = useLocalStorage("access-token", undefined);
	const [, setExpiresIn] = useLocalStorage("expires-in", undefined);
	const [, setAuthSignSignature] = useLocalStorage(
		"auth-sign-signature",
		undefined
	);
	const { data: walletClient } = useWalletClient();
	const { disconnect } = useDisconnect();

	const signout = async () => {
		// 1. Call backend logout
		await authService.signOut();

		// 2. Clear localStorage
		setAccessToken(undefined);
		setExpiresIn(undefined);
		setAuthSignSignature(undefined);

		// 3. Disconnect wallet
		if (walletClient) {
			await disconnect();
		}
	};

	return { signout };
};
```

### Backend: Logout Endpoint

```go
func (h Handler) Logout(ctx *fiber.Ctx) error {
    // Clear session cookie
    ctx.Cookie(&fiber.Cookie{
        Name:     "session",
        Value:    "",
        Expires:  time.Now().Add(-1 * time.Hour), // Expired
        HTTPOnly: true,
    })

    return ctx.SendStatus(fiber.StatusNoContent)
}
```

