erDiagram
    %% Core Authentication & User Management
    authentication_credentials ||--|| profiles : "has exactly one"
    authentication_credentials ||--o{ events : "owns zero or many"
    authentication_credentials ||--o{ event_attendees : "attends zero or many"
    authentication_credentials ||--o{ event_issuers : "issues for zero or many"
    authentication_credentials ||--o{ inbox_messages : "sends zero or many"
    authentication_credentials ||--o{ inbox_messages : "receives zero or many"

    %% Event Management
    events ||--|| event_registration_configs : "has exactly one"
    events ||--o| event_certificate_configs : "has zero or one"
    events ||--o{ event_issuers : "has zero or many issuers"
    events ||--o| event_contracts : "has zero or one"
    events ||--o{ event_attendees : "has zero or many attendees"
    events ||--o{ event_registration_invitations : "has zero or many invitations"
    events ||--o{ event_registration_email_referrals : "has zero or many referrals"
    events ||--o{ event_registration_requirements : "has zero or many requirements"

    %% Event Registration Requirements
    event_registration_requirements }o--|| event_registration_requirement_types : "has exactly one type"
    event_registration_requirements ||--o{ event_registration_requirements_trusted_identities : "requires zero or many identities"
    trusted_identities ||--o{ event_registration_requirements_trusted_identities : "trusted by zero or many"

    %% Inbox Messaging
    inbox_messages }o--|| inbox_message_types : "has exactly one type"
    inbox_messages ||--o| event_registration_invitations : "has zero or one invitation"

    %% Table Definitions
    authentication_credentials {
        uuid id PK
        integer solution_status "0: BYOPK, 1: System Managed"
        varchar hashed_password "Argon2id hash"
        bytea encrypted_private_key "AES-256-GCM encrypted"
        varchar wallet_address UK "Unique wallet address"
        text google_connector_ref "PII Encrypted"
        text github_connector_ref "PII Encrypted"
        integer is_verified_organizer
        integer is_verified_issuer
        integer is_verified_student
        timestamptz created_at
        timestamptz updated_at
    }

    profiles {
        uuid id PK
        uuid authentication_credential_id FK
        integer is_profile_picture_public
        text profile_picture_url "PII Encrypted"
        integer is_first_name_public
        text first_name "PII Encrypted"
        integer is_last_name_public
        text last_name "PII Encrypted"
        integer is_email_public
        text email "PII Encrypted"
        integer is_bio_public
        text bio "PII Encrypted"
        integer is_phone_number_public
        text phone_number "PII Encrypted"
        integer is_address_public
        text address "PII Encrypted"
        integer is_academic_institution_public
        text academic_institution "PII Encrypted"
        integer is_academic_email_public
        text academic_email "PII Encrypted"
        timestamptz created_at
        timestamptz updated_at
    }

    events {
        uuid id PK
        integer chain_id
        varchar contact_number
        varchar contact_address
        uuid owner_credential_id FK
        varchar banner_storage_key
        varchar icon_storage_key
        varchar title
        varchar short_description
        text long_description
        timestamptz start_date
        timestamptz end_date
        varchar location
        varchar google_map_query
        integer max_attendees
        integer is_public "0: Private, 1: Public"
        integer is_booking_request_required
        integer is_verified
        integer is_ticket_transferable
        timestamptz created_at
        timestamptz updated_at
        timestamptz deleted_at
    }

    event_attendees {
        uuid id PK
        uuid event_id FK
        uuid attendee_credential_id FK
        varchar contact_address "Wallet address"
        integer is_attendee_accepted
        text first_name "PII Encrypted"
        text last_name "PII Encrypted"
        text email "PII Encrypted"
        text bio "PII Encrypted"
        text phone_number "PII Encrypted"
        text address "PII Encrypted"
        text academic_institution "PII Encrypted"
        text academic_email "PII Encrypted"
        timestamptz created_at
        timestamptz updated_at
    }

    event_registration_configs {
        uuid id PK
        uuid event_id FK
        timestamptz final_call_for_registration
        text registration_password
        integer first_name_requirement_status "0: Not Required, 1: Required, 2: Optional"
        integer last_name_requirement_status
        integer email_requirement_status
        integer bio_requirement_status
        integer phone_number_requirement_status
        integer address_requirement_status
        integer academic_institution_requirement_status
        integer academic_email_requirement_status
        timestamptz created_at
        timestamptz updated_at
    }

    event_certificate_configs {
        uuid id PK
        uuid event_id FK
        varchar base_certificate_storage_key
        float event_name_pos_x
        float event_name_pos_y
        float name_pos_x
        float name_pos_y
        float academic_institution_pos_x
        float academic_institution_pos_y
        timestamptz created_at
        timestamptz updated_at
    }

    event_issuers {
        uuid id PK
        uuid event_id FK
        uuid issuer_credential_id FK
        integer is_signed "0: Not Signed, 1: Signed"
        text signature "Digital signature"
        text sign_message
        timestamptz created_at
        timestamptz updated_at
    }

    event_contracts {
        uuid id PK
        uuid event_id FK
        varchar access_manager_contract_address
        varchar event_contract_address
        varchar ticket_contract_address
        varchar certificate_contract_address
        timestamptz created_at
        timestamptz updated_at
    }

    inbox_message_types {
        integer id PK
        varchar name
        timestamptz created_at
        timestamptz updated_at
    }

    inbox_messages {
        uuid id PK
        uuid sender_credential_id FK
        uuid receiver_credential_id FK
        integer message_type FK
        jsonb message_content "i18n translations"
        text fallback_message_content
        integer is_read "0: Unread, 1: Read"
        timestamptz created_at
        timestamptz updated_at
        timestamptz hidden_at
        timestamptz deleted_at
    }

    trusted_identities {
        uuid id PK
        varchar name
        text[] expected_identifiers
        text[] expected_issuer_addresses
        integer is_self_issued "0: External, 1: Self-Issued"
        timestamptz created_at
        timestamptz updated_at
    }

    event_registration_requirement_types {
        integer id PK
        varchar name "password-protected, invite-only"
        timestamptz created_at
        timestamptz updated_at
    }

    event_registration_requirements {
        uuid id PK
        uuid event_id FK
        integer requirement_type_id FK
        text password
        integer max_attempts_in_period
        integer period_duration_seconds
        integer is_identity_verification_required
        timestamptz created_at
        timestamptz updated_at
    }

    event_registration_requirements_trusted_identities {
        uuid id PK
        uuid event_registration_requirement_id FK
        uuid trusted_identity_id FK
        timestamptz created_at
        timestamptz updated_at
    }

    event_registration_invitations {
        uuid id PK
        uuid event_id FK
        uuid inbox_message_id FK
        timestamptz valid_until
        text code
        timestamptz created_at
        timestamptz updated_at
    }

    event_registration_email_referrals {
        uuid id PK
        uuid event_id FK
        timestamptz valid_until
        integer is_used "0: Unused, 1: Used"
        text first_name "PII Encrypted"
        text last_name "PII Encrypted"
        text email "PII Encrypted"
        text bio "PII Encrypted"
        text phone_number "PII Encrypted"
        text address "PII Encrypted"
        text academic_institution "PII Encrypted"
        text academic_email "PII Encrypted"
        timestamptz created_at
        timestamptz updated_at
    }
