{
  "name": "decm",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "backend:dev": "cd apps/backend && go run cmd/main.go",
    "backend:build": "cd apps/backend && go build -o bin/decm-backend cmd/main.go",
    "backend:start": "cd apps/backend && ./bin/decm-backend",
    "backend:docs": "cd apps/backend && swag init -g cmd/main.go -o docs",
    "gen-api": "bun run backend:docs && cd packages/api && bun install && bun generate && bun postgenerate && bun run build",
    "compose:up": "docker-compose -f docker-compose.isolated.yml up -d",
    "compose:down": "docker-compose -f docker-compose.isolated.yml down",
    "db:setup": "bun run db:start && bun run db:wait && bun run db:migrate",
    "db:start": "docker-compose -f docker-compose.isolated.yml up -d",
    "db:stop": "docker-compose -f docker-compose.isolated.yml down",
    "db:wait": "bun run scripts/wait-for-db.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:migrate:down": "node scripts/db-command.js migrate down",
    "db:migrate:force": "node scripts/db-command.js migrate force",
    "db:migrate:create": "cd packages/database && migrate create -ext sql -dir ./migrations -seq",
    "db:migrate:version": "node scripts/db-command.js migrate version",
    "db:reset": "bun run db:migrate:down && bun run db:migrate",
    "db:generate": "rm -rf packages/database/go/generated && cd packages/database && sqlc generate",
    "db:status": "node scripts/db-command.js psql \"\\dt\"",
    "db:console": "node scripts/db-command.js psql",
    "db:config": "node scripts/db-env.js"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}