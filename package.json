{
    "name": "decm",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint && pnpm run lint:go",
        "lint:go": "cd apps/backend && golangci-lint run ./...",
        "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md,yaml,yml}\"",
        "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md,yaml,yml}\"",
        "kill:ports": "./kill-ports.sh",
        "dev:web": "pnpm dev --filter @decm/web",
        "dev:core": "cd apps/backend && go run core-api/cmd/main.go",
        "build:core": "cd apps/backend && go build -o bin/decm-backend core-api/cmd/main.go",
        "start:core": "cd apps/backend && ./bin/decm-backend",
        "add-status:core": "cd apps/backend && go run core-api/cmd/add_system_status/main.go",
        "check-gas:core": "cd apps/backend && go run core-api/cmd/check_gas_price/main.go",
        "docs:core": "cd apps/backend && swag init -g core-api/cmd/main.go -o core-api/docs --requiredByDefault",
        "gen-api:core": "pnpm run docs:core && cd packages/api && pnpm install && pnpm generate:core",
        "compose:up": "docker compose -f docker-compose.isolated.yml up -d --build",
        "compose:down": "docker compose -f docker-compose.isolated.yml down",
        "compose:prod:up": "docker compose -f docker-compose.prod.yml up -d --build",
        "compose:prod:down": "docker compose -f docker-compose.prod.yml down",
        "db:setup": "pnpm run db:start && pnpm run db:wait && pnpm run db:migrate",
        "db:start": "docker compose -f docker-compose.isolated.yml up -d",
        "db:stop": "docker compose -f docker-compose.isolated.yml down",
        "db:wait": "node scripts/wait-for-db.js",
        "db:migrate": "node scripts/db-migrate.js",
        "db:migrate:down": "node scripts/db-command.js migrate down",
        "db:migrate:force": "node scripts/db-command.js migrate force",
        "db:migrate:create": "cd packages/database && migrate create -ext sql -dir ./migrations -seq",
        "db:migrate:version": "node scripts/db-command.js migrate version",
        "db:reset": "pnpm run db:migrate:down && pnpm run db:migrate",
        "db:generate": "rm -rf packages/database/go/generated && cd packages/database && sqlc generate",
        "db:status": "node scripts/db-command.js psql \"\\dt\"",
        "db:console": "node scripts/db-command.js psql",
        "db:config": "node scripts/db-env.js",
        "contract:build": "cd apps/contracts && forge install && forge build",
        "contract:build-only": "node scripts/build-contracts.js",
        "contract:generate-types": "node scripts/generate-contract-types.js",
        "contract:generate-go": "node scripts/generate-go-bindings.js",
        "contract:build-and-generate": "pnpm run contract:build-only && pnpm run contract:generate-go",
        "contract:all": "pnpm run contract:build && pnpm run contract:generate-types",
        "contract:build:generate": "pnpm run contract:build && pnpm run contract:generate-go && pnpm run contract:generate-types",
        "contract:decm:setup:dev": "cd apps/contracts && make deployDecmAccessManager ARGS='--network sepolia'",
        "gen-icons:web": "rm -rf apps/web/src/components/icons/gen && pnpm dlx @svgr/cli --typescript --icon --out-dir apps/web/src/components/icons/gen apps/web/src/assets/icons/*",
        "prepare": "lefthook install",
        "test:web": "cd apps/web && pnpm test",
        "test:web:coverage": "cd apps/web && pnpm test:coverage",
        "test:web:coverage:report": "cd apps/web && pnpm test:coverage:report",
        "test:core": "cd apps/backend && go test ./...",
        "test:core:verbose": "cd apps/backend && go test -v ./...",
        "test:core:coverage": "cd apps/backend && go test -cover ./...",
        "test:core:coverage:report": "cd apps/backend && go test -coverprofile=coverage.out ./... && go tool cover -html=coverage.out",
        "test:core:coverage:analyze": "tsx scripts/analyze-backend-coverage.ts"
    },
    "devDependencies": {
        "@types/node": "^24.10.1",
        "ethers": "^6.16.0",
        "lefthook": "^1.11.1",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2",
        "tsx": "^4.21.0",
        "turbo": "^2.5.5",
        "typescript": "5.8.3"
    },
    "dependencies": {
        "next-i18next": "^15.4.2"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "prettier --write",
            "bash -c 'cd apps/backend && gofmt -w $(git diff --cached --name-only -- \"*.go\") || true'"
        ],
        "*.{json,css,scss,md,yaml,yml}": "prettier --write"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "pnpm@9.15.0",
    "pnpm": {
        "overrides": {
            "vite": "7.1.9"
        }
    }
}
