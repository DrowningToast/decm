# DECM CI Testing Configuration
# This file is used for CI/CD pipeline testing only

# Environment
ENVIRONMENT=test

# Server
PORT=8080

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=decm_user
DB_PASSWORD=decm_test_password
DB_NAME=decm_test
DB_SSL_MODE=disable

# PII Encryption Configuration
PII_ENCRYPTION_KEY=test-encryption-key-for-ci-pipeline-only-32bytes

# Blockchain Configuration
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=1337

# JWT Configuration
JWT_ISSUER=decm-service-test
JWT_SECRET=test-jwt-secret-key-for-ci-pipeline-only
JWT_EXPIRATION=24h

# LDAP Configuration (Academic Identity Verification)
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_USER=
LDAP_BIND_PASS=

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_DIR=uploads

# S3 Configuration (Test - MinIO or Mock)
S3_ACCESS_KEY_ID=test-access-key
S3_SECRET_ACCESS_KEY=test-secret-key
S3_BUCKET_NAME=decm-test
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# Google OAuth Secrets (Test)
GOOGLE_OAUTH_CLIENT_ID=test-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/verify-google-oauth
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3000/auth/success

# Frontend API & App URLs
VITE_APP_URL=http://localhost:3000
VITE_CORE_BACKEND_API=http://localhost:8080
VITE_ENVIRONMENT=development

# Wallet Connector Id
VITE_WALLETCONNECT_PROJECT_ID=2e5fa163c0af1ed5af49e2f1f0685423

VITE_GOOGLE_MAPS_API_KEY=AIzaSyD2JC8-2B6PpCq3ZW34rod14enmefRj1zws

# Docker Deployment Configuration (Test Defaults)
CORE_ENVIRONMENT=test
BACKEND_IMAGE=decm-backend-test
BACKEND_IMAGE_TAG=ci
BACKEND_HTTP_PORT=8080
FRONTEND_IMAGE=decm-frontend-test
FRONTEND_IMAGE_TAG=ci
FRONTEND_HTTP_PORT=3000
TZ=UTC
NPM_HTTP_PORT=8081
NPM_HTTPS_PORT=8443
