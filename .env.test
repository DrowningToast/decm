# DECM Backend Configuration for CI Testing
# This file is used exclusively for CI/CD pipeline testing

# Environment
ENVIRONMENT=test

# Server
PORT=8080

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=decm_user
DB_PASSWORD=decm_password
DB_NAME=decm_test
DB_SSL_MODE=disable

# PII Encryption Configuration (32-byte key for AES-256-GCM)
# This is a test key - NEVER use in production
PII_ENCRYPTION_KEY=test-encryption-key-32bytes-long!!!

# Blockchain Configuration
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=1337

# JWT Configuration
JWT_ISSUER=decm-service-test
JWT_SECRET=test-jwt-secret-key-change-in-production
JWT_EXPIRATION=24h

# LDAP Configuration (Academic Identity Verification)
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_USER=
LDAP_BIND_PASS=

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_DIR=uploads

# S3 Configuration (Required for file uploads) - Using MinIO for testing
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=decm-events-test
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# Google OAuth Secrets (test values)
GOOGLE_OAUTH_CLIENT_ID=test-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/verify-google-oauth
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3000/auth/success

# Google Maps API (for event venue display)
VITE_GOOGLE_MAPS_API_KEY=test-api-key
