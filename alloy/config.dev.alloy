// Grafana Alloy Configuration (Development - File-based)
// https://grafana.com/docs/alloy/latest/
//
// This config is for development where the backend runs on the host (not in Docker)
// and logs to files. Alloy tails the log files directly.

// Logging configuration for Alloy itself
logging {
  level  = "info"
  format = "logfmt"
}

// ============================================
// Loki Write Endpoint
// ============================================
loki.write "loki_endpoint" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }

  // External labels applied to all logs
  external_labels = {
    cluster      = "decm",
    environment  = env("ENVIRONMENT"),
    service_name = "decm-backend",
  }
}

// ============================================
// Local File Discovery - Backend Logs
// ============================================
// Discovers all log files in the backend logs directory
local.file_match "backend_logs" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/backend/logs/*.log",
  }]
}

// ============================================
// Log File Tailing
// ============================================
// Tail log files and process them
loki.source.file "backend_logs" {
  targets    = local.file_match.backend_logs.targets
  forward_to = [loki.process.backend_json.receiver]

  // Start from end on first run
  tail_from_end = true
}

// ============================================
// Log Processing Pipeline
// ============================================
// Process and parse logs (supports both JSON and logfmt)
loki.process "backend_json" {
  forward_to = [loki.write.loki_endpoint.receiver]

  // Stage 1: Extract low-cardinality fields needed for labels and timestamp.
  // High-cardinality fields (user_id, request_id, error, path, duration, etc.)
  // are NOT extracted here — they stay in the raw JSON body and are accessible
  // in Grafana Explore via `| json <field>` without any cardinality cost.
  stage.json {
    expressions = {
      timestamp = "time",
      level     = "level",
      component = "component",
      method    = "method",
      status    = "status",
    }
  }

  // Stage 2: Extract timestamp
  // Go slog emits sub-second precision (e.g. .879657Z), so RFC3339Nano is primary.
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"

    fallback_formats = [
      "RFC3339",
    ]
  }

  // Stage 3: Convert level to lowercase for Grafana compatibility
  stage.template {
    source   = "level"
    template = "{{ ToLower .Value }}"
  }

  // Stage 4: Promote only low-cardinality fields to Loki labels.
  // Everything else (msg, error, user_id, request_id, source, path, duration)
  // remains in the raw JSON log line and is queryable via `| json`.
  stage.labels {
    values = {
      level     = "",
      component = "",
      method    = "",
      status    = "",
      job       = "backend",
      app       = "decm-backend",
      service   = "decm-backend",
    }
  }

  // Stage 5: Drop empty log lines
  stage.drop {
    expression = "^\\s*$"
  }
}
