// Grafana Alloy Configuration
// https://grafana.com/docs/alloy/latest/

// Logging configuration for Alloy itself
logging {
  level  = "info"
  format = "logfmt"
}

// ============================================
// Loki Write Endpoint
// ============================================
loki.write "loki_endpoint" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"

    // Optional: Add basic auth if Loki has auth enabled
    // basic_auth {
    //   username = env("LOKI_USERNAME")
    //   password = env("LOKI_PASSWORD")
    // }
  }

  // External labels applied to all logs
  external_labels = {
    cluster      = "decm",
    environment  = env("ENVIRONMENT"),
    service_name = "decm-backend",
  }
}

// ============================================
// Docker Container Discovery
// ============================================
// Discovers Docker containers to collect logs from
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"

  // Filter: only collect logs from containers with label logging=alloy
  filter {
    name   = "label"
    values = ["logging=alloy"]
  }
}

// ============================================
// Docker Logs Collection
// ============================================
// Collect stdout/stderr from Docker containers
loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  forward_to       = [loki.process.backend_json.receiver]
  refresh_interval = "5s"

  // Relabel rules to extract container metadata
  relabel_rules {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  relabel_rules {
    source_labels = ["__meta_docker_container_id"]
    target_label  = "container_id"
  }

  relabel_rules {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }

  relabel_rules {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

// ============================================
// Log Processing Pipeline
// ============================================
// Process and parse logs (supports both JSON and logfmt)
loki.process "backend_json" {
  forward_to = [loki.write.loki_endpoint.receiver]

  // Stage 1: Try to parse as JSON first
  stage.json {
    expressions = {
      timestamp  = "time",
      level      = "level",
      message    = "msg",
      source     = "source",
      error      = "error",
      request_id = "request_id",
      method     = "method",
      path       = "path",
      status     = "status",
      duration   = "duration",
      user_id    = "user_id",
    }
  }

  // Stage 2: If JSON fails, parse as logfmt (key=value format)
  stage.logfmt {
    mapping = {
      timestamp  = "time",
      level      = "level",
      message    = "msg",
      source     = "source",
      error      = "err",
    }
  }

  // Stage 3: Extract timestamp
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"

    // Fallback formats if RFC3339 fails
    fallback_formats = [
      "RFC3339Nano",
      "2006-01-02T15:04:05.999999999Z07:00",
    ]
  }

  // Stage 4: Convert level to lowercase for Grafana compatibility
  stage.template {
    source   = "level"
    template = "{{ ToLower .Value }}"
  }

  // Stage 5: Add labels from parsed fields
  stage.labels {
    values = {
      level      = "",
      method     = "",
      status     = "",
      job        = "backend",
      app        = "decm-backend",
      service    = "decm-backend",
    }
  }

  // Stage 6: Output - use message field as log line
  stage.output {
    source = "message"
  }

  // Stage 7: Drop empty log lines
  stage.drop {
    expression = "^\\s*$"
  }
}
