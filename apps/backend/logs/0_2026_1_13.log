{"time":"2026-01-13T19:48:10.580762Z","level":"INFO","source":{"function":"github.com/mcosta74/pgx-slog.(*Logger).Log","file":"/Users/supratouchsuwatno/go/pkg/mod/github.com/mcosta74/pgx-slog@v0.4.1/adapter.go","line":60},"msg":"Query","time":3305375,"commandTag":"SELECT 1","pid":72301,"sql":"-- name: GetClaimedCertificatesByCredentialID :many\nSELECT \n    ec.id,\n    ec.event_id,\n    ec.receiver_credential_id,\n    ec.receiver_email,\n    ec.name,\n    ec.academic_institution,\n    ec.certificate_title,\n    ec.certificate_subtitle,\n    ec.event_contract_address,\n    ec.event_certificate_address,\n    ec.certificate_token_id,\n    ec.certificate_digest,\n    ec.inbox_message_id,\n    ec.created_at,\n    ec.revoked_at,\n    e.title as event_name\nFROM event_certificates ec\nINNER JOIN events e ON ec.event_id = e.id\nWHERE (\n    ec.receiver_credential_id = $1\n    OR ec.receiver_email = $2\n  )\n  AND ec.certificate_token_id IS NOT NULL\n  AND ec.revoked_at IS NULL\nORDER BY ec.created_at DESC\n","args":["0afefdb3-eae7-4f04-bda6-f8ec1434be1d","ZNENwSSd2OEjz7TyQjUHPRd3vXJpA2mYXR1jdE5HcitFsGfXZub88sUsrMr4UGyThl3VArCI"]}
