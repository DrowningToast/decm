# DECM Backend Configuration Template
# Copy this file to .env in the root directory and update the values

# Environment
ENVIRONMENT=development

# Server
PORT=8080

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=decm_password
DB_NAME=decm
DB_SSL_MODE=disable

# PII Encryption Configuration
PII_ENCRYPTION_KEY=your-encryption-key-change-this-in-production

# Blockchain Configuration
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=1337

# JWT Configuration
JWT_ISSUER=decm-service
JWT_SECRET=your-secret-key-change-this-in-production
# 24h = 24 hours (Go duration format: s=seconds, m=minutes, h=hours)
JWT_EXPIRATION=24h

# LDAP Configuration (Academic Identity Verification)
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_USER=
LDAP_BIND_PASS=

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_DIR=uploads

# External APIs
# Add any external API keys or endpoints here

# Google OAuth Secrets
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/verify-google-oauth
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3000/oauth-success/google

# Google Maps API (for event venue display)
VITE_GOOGLE_MAPS_API_KEY=