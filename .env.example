# DECM Configuration Template (Backend + Frontend)
# Copy this file to .env in the root directory and update the values
# This single file contains both backend (Go) and frontend (React/Vite) configuration
# Frontend variables must be prefixed with VITE_

# Environment
ENVIRONMENT=development

# Server
PORT=8080

# CORS Configuration (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Domain Configuration
# Leave empty for development (host-only cookies)
# Set to domain (e.g., tcas.it.kmitl.ac.th) for production (domain-wide cookies)
COOKIE_DOMAIN=

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=decm_password
DB_NAME=decm
DB_SSL_MODE=disable
# Enable SQL query logging (useful for development debugging)
DB_DEBUG=true

# PII Encryption Configuration
PII_ENCRYPTION_KEY=your-encryption-key-change-this-in-production

# Blockchain Configuration
BLOCKCHAIN_NETWORK=localhost
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CHAIN_ID=1337
BLOCKCHAIN_DECM_ACCESS_MANAGER_ADDRESS=
BLOCKCHAIN_ETHERSCAN_API_KEY=
# Gas Management (Optional - prevents massive gas spikes)
BLOCKCHAIN_SOFT_CAP_GAS_PRICE_GWEI=1000
BLOCKCHAIN_MAX_GAS_PRICE_GWEI=2500
# Gas limit for transactions (3000000 for contract deployments, 500000 for transfers)
BLOCKCHAIN_GAS_LIMIT=3000000

# JWT Configuration
JWT_ISSUER=decm-service
JWT_SECRET=your-secret-key-change-this-in-production
# 24h = 24 hours (Go duration format: s=seconds, m=minutes, h=hours)
JWT_EXPIRATION=24h

# LDAP Configuration (Academic Identity Verification)
LDAP_HOST=ldap.example.com
LDAP_PORT=389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_USER=
LDAP_BIND_PASS=

# File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_DIR=uploads

# S3 Configuration (Required for file uploads)
# For MinIO/Self-hosted S3 (Local Development) - Recommended:
#   S3_ACCESS_KEY_ID=minioadmin
#   S3_SECRET_ACCESS_KEY=minioadmin
#   S3_BUCKET_NAME=decm-events
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1 (optional - will use default if not set)
# For AWS S3 (Production):
#   S3_REGION=us-east-1 (REQUIRED - must match your bucket's region!)
#   S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT=
S3_REGION=

# External APIs
# Add any external API keys or endpoints here

# Google OAuth Secrets
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/verify-google-oauth
GOOGLE_OAUTH_SUCCESS_URL=http://localhost:3000/auth/success

# Metrics Configuration (API Key Protection)
METRICS_API_KEY=your-metrics-api-key-change-this

# ============================================
# Frontend Configuration (React + Vite)
# ============================================
# IMPORTANT: All frontend variables MUST be prefixed with VITE_

# Frontend API & App URLs
VITE_CORE_BACKEND_API=http://localhost:8080
VITE_APP_URL=http://localhost:3000
VITE_ENVIRONMENT=development

# Google Maps API (for event venue display)
VITE_GOOGLE_MAPS_API_KEY=

# WalletConnect Project ID (for Web3 wallet connections)
VITE_WALLETCONNECT_PROJECT_ID=

# ============================================
# Docker Deployment Configuration
# ============================================
CORE_ENVIRONMENT=production
BACKEND_IMAGE=decm-backend
BACKEND_IMAGE_TAG=latest
BACKEND_HTTP_PORT=8080
FRONTEND_IMAGE=decm-frontend
FRONTEND_IMAGE_TAG=latest
FRONTEND_HTTP_PORT=3000
TZ=UTC
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=change-me
NPM_DISABLE_IPV6=true

