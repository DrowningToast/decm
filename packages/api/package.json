{
    "name": "@decm/api",
    "version": "1.0.0",
    "description": "Generated TypeScript API client for DECM backend",
    "main": "src/index.ts",
    "types": "src/index.ts",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "clean": "rm -rf dist generated",
        "generate:core": "swagger-typescript-api generate -p ../../apps/backend/core-api/docs/swagger.json -o ./src/apis/core/ -n api.ts --axios --module-name-index 1 --sort-types --extract-request-params --extract-request-body --extract-response-body --extract-response-error --unwrap-response-data --single-http-client"
    },
    "files": [
        "dist/**/*",
        "src/**/*"
    ],
    "dependencies": {
        "axios": "^1.6.0"
    },
    "devDependencies": {
        "@repo/typescript-config": "workspace:*",
        "swagger-typescript-api": "^13.2.9",
        "@types/node": "^22.10.4",
        "typescript": "^5.8.3"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "publishConfig": {
        "access": "restricted"
    }
}
